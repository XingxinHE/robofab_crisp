# Copy this file to .env on each machine:
#   cp .env.example .env
#
# Select the LAN/Wi-Fi interface that ROS 2 DDS should use.
# Do NOT use the Franka FCI/control NIC, typically on 172.16.0.0/24.
# Find interface names with:
#   ip -br addr

# Single-machine fallback:
ROS_NETWORK_INTERFACE=lo

# Multi-machine example:
# ROS_NETWORK_INTERFACE=enp2s0
